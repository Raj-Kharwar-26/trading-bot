# Root build-context exclusions (used by deployment/docker-compose.cloud.yml
# where context is the project root). Prevents secrets + local junk shipping.

# Secrets / env
.env
**/.env
deployment/omniroute/.env
**/.env.*

# Python
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/*.log

# Data & runtime (volume-mounted, not baked)
data/
logs/
audit_logs/
reflections/
paper_logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# VCS / editors
.git/
.gitignore
.vscode/
.idea/
node_modules/

# Keep the Kubernetes/helm if present, but ignore bulky backups
backups/
*.bak