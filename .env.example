# Copy to .env and fill in real values. NEVER commit .env.

# Telegram
TELEGRAM_BOT_TOKEN=

# AI Router (OmniRoute)
# OmniRoute OpenAI-compatible endpoint
# NOTE: the field is "omniroute" (omni-route) — env var MUST be OMNIROUTE_*
# (with the "o"), otherwise settings falls back to the localhost default.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Critical-decision LLM provider (reliable, structured output)
CRITICAL_LLM_BASE_URL=
CRITICAL_LLM_API_KEY=
CRITICAL_LLM_MODEL=

# Shallow task model (may be free pool / cheap)
SHALLOW_LLM_MODEL=

# Market data
OPENBB_PAT_TOKEN=            # optional, for extended data
MARKETAUX_API_KEY=           # optional, for news sentiment (TradingView MCP)
CRYPTO_PRICE_PROVIDER=binance  # 'binance' (keyless, all alts) or 'yfinance'

# Postgres / Redis / Vector store
POSTGRES_DSN=postgresql://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_URL=
CHROMA_PATH=./data/chroma

# Qdrant embedding placement (OOM fix on constrained hosts like Render free)
# SERVER_SIDE_EMBEDDINGS=true delegates text embedding to Qdrant Cloud
#   Inference (no in-process fastembed/ONNX model); false embeds locally.
SERVER_SIDE_EMBEDDINGS=false
# Model used by server-side inference (must match the collection dimension).
# Free on Qdrant free-tier clusters: sentence-transformers/all-MiniLM-L6-v2 (384d)
QDRANT_INFERENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Execution (Phase 3+)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

# Zerodha Kite Connect (Phase 4, LIVE — keep OFF by default)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Risk limits (hard, code-enforced)
MAX_LOSS_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MIN_RR_RATIO=1.5
MAX_POSITION_PCT=0.05
MAX_CONCURRENT_POSITIONS=10
MAX_TOTAL_EXPOSURE=0.30

# Safety / approval
APPROVAL_REQUIRED=true
LIVE_TRADING_ENABLED=false
ALLOWED_TELEGRAM_USER_IDS=
