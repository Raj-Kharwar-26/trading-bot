# Docker build context exclusions for the backend image.
# Critical: NEVER bake .env files (secrets) into the image.

# Secrets / local config
.env
backend/.env
**/.env

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data & runtime (bind-mounted / volumes, not baked)
data/
logs/
audit_logs/
reflections/
paper_logs/
*.sqlite

# Local dev
.venv/
venv/
*.log

# VCS / editor
.git/
.vscode/
.idea/
node_modules/