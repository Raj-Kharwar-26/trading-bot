{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "dockerbuildArgs": {},
    "watchPatterns": ["backend/**", "deployment/**", "docs/**", "requirements.txt", "vendor/**"]
  },
  "deploy": {
    "startCommand": "python -m backend.telegram.bot",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300
  },
  "secrets": ["TELEGRAM_BOT_TOKEN", "STORAGE_ENCRYPTION_KEY", "ALLOWED_TELEGRAM_USER_IDS"]
}